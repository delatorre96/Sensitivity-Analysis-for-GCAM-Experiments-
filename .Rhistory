update_number_iterations <- function(con, experiment_id = NULL){
if(is.null(experiment_id)){
ids <- DBI::dbGetQuery(
con,
"SELECT experiment_id FROM Experiments"
)$experiment_id
} else {
ids <- experiment_id
}
for(id in ids){
n <- DBI::dbGetQuery(
con,
sprintf(
"SELECT COUNT(*) AS n
FROM Runs
WHERE experiment_id='%s'",
id
)
)$n
DBI::dbExecute(
con,
sprintf(
"UPDATE Experiments
SET number_iterations=%d
WHERE experiment_id='%s'",
n,
id
)
)
}
invisible(TRUE)
}
